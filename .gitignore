# Root .gitignore for War Room project

# Documentation files
*.md
README.md
CHANGELOG.md
QUICKSTART.md
ROUTING.md
TODO.md
NOTES.md

# Dependencies
node_modules/
*/node_modules/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.local

# Build outputs
dist/
build/
*/dist/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
*/coverage/

# Cache files
.cache/
.parcel-cache/
.eslintcache
*/.cache/
*/.eslintcache

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
*.bak

# Database files
*.db
*.sqlite
*.sqlite3

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Test files
*.test.js.snap
*.test.jsx.snap